FROM quay.io/aipcc/agentic-ci/openshell@sha256:06a978ed76d32f2341f9a36271a5ce21cf64a9a562b0eb04d0d9eb1aeb23729f

USER 0
RUN dnf install -y python3 shadow-utils \
    && dnf clean all \
    && groupadd --gid 1500 openshell-agent \
    && useradd --uid 1500 --gid 1500 --home-dir /opt/openshell-lab \
        --no-create-home --shell /sbin/nologin openshell-agent

WORKDIR /opt/openshell-lab
COPY --chown=1500:1500 src/openshell_lab /opt/openshell-lab/openshell_lab

ENV PYTHONPATH=/opt/openshell-lab \
    PYTHONDONTWRITEBYTECODE=1

USER 1500:1500
ENTRYPOINT ["python3", "-m", "openshell_lab.cli"]
CMD ["--output", "/var/www/html/nvidia-openshell-last-5-merges.md"]
